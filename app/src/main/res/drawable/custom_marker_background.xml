<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval"

    >

    <!-- Outer border -->
    <stroke
        android:width="4dp"
        android:color="#FFFFFF" /> <!-- Border color -->

    <!-- Background color inside the circle -->
    <solid android:color="@color/lightblue" /> <!-- White inner background -->

    <!-- Size and padding (optional) -->
    <size
        android:width="48dp"
        android:height="48dp" />
</shape>
