                android:textSize="18sp"

                >

            </TextView>

            <EditText
                android:id="@+id/editText_responderUserPassword"


                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"

                android:background="@drawable/rounded_box_input_white"
                android:fontFamily="@font/inter_bold"
                android:hint="Your Password"

                android:inputType="text"
                android:padding="12dp"
                android:textColor="@color/white"
                android:textColorHint="#ADFFFFFF">

            </EditText>

        </LinearLayout>

        <Button
            android:id="@+id/buttonFinish_responderOtherInformationSetup"
            android:layout_width="match_parent"
            android:layout_height="60dp"

            android:layout_marginLeft="46dp"
            android:layout_marginRight="46dp"

            android:layout_marginTop="24dp"
            android:backgroundTint="@color/white"

            android:fontFamily="@font/inter_bold"
            android:text="FINISH"
            android:textColor="#7BC3FD"
            android:textSize="28sp"

            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/linearLayout3">

        </Button>
    </LinearLayout>



</androidx.constraintlayout.widget.ConstraintLayout>