<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Activity.UserRegistration.NewUserActivity"
    android:background="#7BC3FD"
    >

    <ImageView
        android:id="@+id/logoImage"
        android:layout_width="140dp"
        android:layout_height="140dp"

        android:layout_centerInParent="true"
        android:layout_marginTop="30dp"
        android:src="@drawable/logo_app"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_marginTop="12dp"

        android:gravity="center"
        android:text="Register"
        android:textColor="@color/white"
        android:textSize="36sp"

        android:fontFamily="@font/inter_bold"

        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@+id/logoImage">

    </TextView>
    <TextView
        android:id="@+id/textView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:text="What type of user are you?"
        android:textColor="#FFFFFF"
        android:textSize="21sp"
        app:layout_constraintTop_toBottomOf="@+id/textView2"

        android:fontFamily="@font/inter_regular"

        android:layout_marginTop="8dp"
        android:layout_marginLeft="32dp"
        android:layout_marginRight="32dp"

        android:textAlignment="center"
        >

    </TextView>


    <TextView
        android:id="@+id/textView_AlreadyHaveAnAccount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:fontFamily="@font/inter_regular"
        android:text="I already have an account"
        android:textAlignment="center"

        android:textColor="#FFFFFF"

        android:textSize="16sp"


        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@+id/buttonResponder">

    </TextView>

    <FrameLayout
        android:id="@+id/buttonParent"
        android:layout_width="180dp"
        android:layout_height="120dp"
        android:background="@drawable/rounded_button"
        app:backgroundTint="@color/white"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView"
        android:padding="6dp"
        >

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/parent_icon"
            android:layout_gravity="center_horizontal|top"
            android:contentDescription="Button Image" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PARENT"
            android:fontFamily="@font/inter_bold"

            android:layout_gravity="center_horizontal|bottom"
            android:textColor="#7BC3FD"
            android:textSize="26sp"
            android:gravity="center"

            />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/buttonResponder"
        android:layout_width="180dp"
        android:layout_height="120dp"
        android:background="@drawable/rounded_button"
        app:backgroundTint="@color/white"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/buttonChild"
        android:padding="6dp"
        >

        <ImageView
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:src="@drawable/responder_icon"
            android:layout_gravity="center_horizontal|top"
            android:contentDescription="Button Image" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RESPONDER"
            android:fontFamily="@font/inter_bold"

            android:layout_gravity="center_horizontal|bottom"
            android:textColor="#7BC3FD"
            android:textSize="24sp"
            android:gravity="center"

            />
    </FrameLayout>
    <FrameLayout
        android:id="@+id/buttonChild"
        android:layout_width="180dp"
        android:layout_height="120dp"
        android:background="@drawable/rounded_button"
        app:backgroundTint="@color/white"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/buttonParent"
        android:padding="6dp"
        >

        <ImageView
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:src="@drawable/child_icon"
            android:layout_gravity="center_horizontal|top"
            android:contentDescription="Button Image" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CHILD"
            android:fontFamily="@font/inter_bold"

            android:layout_gravity="center_horizontal|bottom"
            android:textColor="#7BC3FD"
            android:textSize="26sp"
            android:gravity="center"

            />
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>