<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".WelcomeActivity"
    android:background="@color/white"

    android:padding="16dp"
    android:visibility="visible"
    >


    <ImageView
        android:id="@+id/logoImage"
        android:layout_width="200dp"
        android:layout_height="200dp"

        android:layout_centerInParent="true"
        android:layout_marginTop="80dp"
        android:src="@drawable/logo_app"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_marginTop="16dp"

        android:gravity="center"
        android:text="Hello"
        android:textColor="@color/black"
        android:textSize="42sp"

        android:fontFamily="@font/inter_bold"

        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@+id/logoImage">

    </TextView>

    <TextView
        android:id="@+id/textView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:text="Welcome to DOS Locator App, your trusted companion for real-time tracking family members. Stay connected and secure, all in one app!"
        android:textColor="#9F9F9F"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@+id/textView2"

        android:fontFamily="@font/inter_regular"

        android:layout_marginTop="16dp"
        android:layout_marginLeft="32dp"
        android:layout_marginRight="32dp"

        android:textAlignment="center"
        >

    </TextView>



    <Button
        android:id="@+id/button_alreadyHaveAnAccount"
        android:layout_width="280dp"
        android:layout_height="70dp"
        android:backgroundTint="#7BC3FD"

        android:layout_marginTop="46dp"

        android:padding="10dp"
        android:text="Already have an account"
        android:textSize="16sp"
        android:textColor="#FFFFFF"

        android:fontFamily="@font/inter_regular"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView" />
    <Button
        android:id="@+id/button_NewUser"
        android:layout_width="280dp"
        android:layout_height="70dp"
        android:backgroundTint="#BBBBBB"

        android:layout_marginTop="16dp"


        android:padding="10dp"
        android:text="I'am a new user"
        android:textSize="16sp"

        android:fontFamily="@font/inter_regular"

        android:textColor="#000000"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/button_alreadyHaveAnAccount"

        />
</androidx.constraintlayout.widget.ConstraintLayout>