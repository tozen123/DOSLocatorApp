<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".LoginActivity"

    android:padding="16dp"

    >
    <ImageView
        android:id="@+id/logoImage"
        android:layout_width="160dp"
        android:layout_height="160dp"

        android:layout_centerInParent="true"
        android:layout_marginTop="50dp"
        android:src="@drawable/logo_app"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_marginTop="16dp"

        android:gravity="center"
        android:text="Login"
        android:textColor="@color/black"
        android:fontFamily="@font/inter_bold"

        android:textSize="42sp"


        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@+id/logoImage"></TextView>

    <Button
        android:layout_marginBottom="18dp"

        android:id="@+id/button_login"
        android:layout_width="280dp"
        android:layout_height="70dp"
        android:backgroundTint="#7BC3FD"

        android:fontFamily="@font/inter_bold"
        android:padding="10dp"

        android:text="LOGIN"
        android:textColor="#FFFFFF"

        android:textSize="21sp"

        app:layout_constraintBottom_toTopOf="@+id/text_alreadyHaveAnAccount"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

    </Button>

    <TextView
        android:id="@+id/text_alreadyHaveAnAccount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:fontFamily="@font/inter_regular"

        android:layout_marginBottom="16dp"

        android:padding="4dp"
        android:textSize="18sp"
        android:text="I don’t have an account"
        android:gravity="center"
        android:textColor="#7BC3FD"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

    </TextView>

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_marginTop="18dp"

        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView2"

        android:paddingRight="28dp"
        android:paddingLeft="28dp"

        >

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:fontFamily="@font/inter_bold"
            android:text="Email"
            android:textColor="@color/black"
            android:textSize="18sp"

            >

        </TextView>

        <EditText
            android:id="@+id/editText_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"

            android:background="@drawable/rounded_box_input_blue"
            android:fontFamily="@font/inter_regular"

            android:hint="Youremail@gmail.com"

            android:inputType="textEmailAddress"
            android:padding="12dp">

        </EditText>

    </LinearLayout>


    <LinearLayout

        android:id="@+id/linearLayout7"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_marginTop="18dp"

        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout"

        android:paddingRight="28dp"
        android:paddingLeft="28dp"

        >

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:fontFamily="@font/inter_bold"
            android:text="Password"
            android:textColor="@color/black"
            android:textSize="18sp">

        </TextView>

        <EditText
            android:id="@+id/editText_password"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"

            android:background="@drawable/rounded_box_input_blue"
            android:fontFamily="@font/inter_regular"

            android:hint="Password"

            android:inputType="textEmailAddress"
            android:padding="12dp">

        </EditText>

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>